COMPOSE_PROJECT_NAME=nginx-load-balancer
HTTP_PORT=8081
SERVER_NAME=lb.local
# round-robin: leave empty | least_conn; | ip_hash;
LB_METHOD=least_conn;
BACKEND_1=backend1:3000
BACKEND_2=backend2:3000
BACKEND_3=backend3:3000
MAX_FAILS=3
FAIL_TIMEOUT=10s
PROXY_CONNECT_TIMEOUT=3s
PROXY_READ_TIMEOUT=30s
