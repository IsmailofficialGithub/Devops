COMPOSE_PROJECT_NAME=nginx-api-gateway
HTTP_PORT=8083
SERVER_NAME=api.local
USERS_HOST=users-api
USERS_PORT=4001
ORDERS_HOST=orders-api
ORDERS_PORT=4002
AUTH_HOST=auth-api
AUTH_PORT=4003
CORS_ORIGIN=https://portfolio.local
ALLOWED_METHODS=GET|HEAD|POST|PUT|PATCH|DELETE|OPTIONS
PROXY_READ_TIMEOUT=30s
