map $$http_upgrade $$connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${SERVER_NAME};

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ws: wss:; media-src 'self' blob:" always;

    if ($$request_method !~ ^(GET|HEAD|POST|OPTIONS)$) {
        return 405;
    }

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $$uri $$uri/ /index.html;
    }

    location ${WS_PATH} {
        proxy_pass http://${STREAM_HOST}:${STREAM_PORT}${WS_PATH};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $$http_upgrade;
        proxy_set_header Connection $$connection_upgrade;
        proxy_set_header Host $$host;
        proxy_set_header X-Real-IP $$remote_addr;
        proxy_set_header X-Forwarded-For $$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $$scheme;
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
    }

    location ${SOCKETIO_PATH} {
        proxy_pass http://${STREAM_HOST}:${STREAM_PORT}${SOCKETIO_PATH};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $$http_upgrade;
        proxy_set_header Connection $$connection_upgrade;
        proxy_set_header Host $$host;
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
        proxy_send_timeout ${PROXY_SEND_TIMEOUT};
    }

    location ${MEDIA_PATH} {
        proxy_pass http://${STREAM_HOST}:${STREAM_PORT}${MEDIA_PATH};
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_set_header Host $$host;
        proxy_read_timeout ${PROXY_READ_TIMEOUT};
    }
}
